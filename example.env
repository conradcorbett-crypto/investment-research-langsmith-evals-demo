# Copy this file to `.env` and replace the placeholders with real keys.
# Never commit `.env`.

# Required to upload datasets/experiments and to run evaluate_*.py
# Create a key at https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY='*****'

# Optional. Default is the US cloud API.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Required for Exercise 2 and Exercise 3 (LLM-as-judge in the SDK scripts)
OPENAI_API_KEY='*****'

# Optional. Default judge model for the SDK evaluators.
# RESEARCH_JUDGE_MODEL=gpt-4.1-mini
